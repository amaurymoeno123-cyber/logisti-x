# =============================================================================
# LOGISTI-X - variables de entorno
#
# Copie este archivo a .env y ponga los valores reales.
# .env ESTA EN .gitignore: nunca se sube al repositorio, ni al zip de la
# entrega, ni se pega en un chat. Si una clave se expone, no basta con
# borrarla: hay que ROTARLA.
# =============================================================================

# --- Base de datos -----------------------------------------------------------
LOGISTIX_DB_URL=jdbc:postgresql://localhost:5434/logistix
LOGISTIX_DB_USER=logistix
LOGISTIX_DB_PASSWORD=cambieme

# --- Seguridad ---------------------------------------------------------------
# Minimo 32 caracteres. Generar uno nuevo por entorno, por ejemplo con:
#   openssl rand -base64 48
LOGISTIX_JWT_SECRETO=cambieme-por-una-cadena-larga-y-aleatoria-de-32-o-mas

# --- Puerto ------------------------------------------------------------------
LOGISTIX_PORT=8085

# --- Integracion con los demas microproyectos INTEGRAX -----------------------
# En true, LOGISTI-X usa los dobles de prueba en memoria y no sale a la red.
VENTAS_SIMULADO=true
VENTAS_URL=http://localhost:8080
VENTAS_API_KEY=

CRM_SIMULADO=true
CRM_URL=http://localhost:8081
CRM_API_KEY=

# --- Publicacion de eventos hacia SALES-X, FINAN-X y SERVI-X -----------------
EVENTOS_HABILITADOS=false
